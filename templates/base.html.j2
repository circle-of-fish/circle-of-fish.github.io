<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ site.title }}{% endblock %}</title>
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta name="description" content="{% block description %}{{ site.meta_description }}{% endblock %}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:url" content="{{ base_url }}/{{ '' if lang == 'en' else lang + '/' }}{{ page_file }}">
<meta property="og:image" content="{{ base_url }}/fish-circle.svg">
<meta name="twitter:card" content="summary_large_image">
{% for l in langs %}
<link rel="alternate" hreflang="{{ l }}" href="{{ base_url }}/{{ '' if l == 'en' else l + '/' }}{{ page_file }}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ base_url }}/{{ page_file }}">
<link rel="canonical" href="{{ base_url }}/{{ '' if lang == 'en' else lang + '/' }}{{ page_file }}">
<link rel="icon" href="{{ prefix }}favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ font_href }}">
<link rel="stylesheet" href="{{ prefix }}style.css">
<style>:root { --cjk-sans: {{ cjk_sans }}; --cjk-serif: {{ cjk_serif }}; }</style>
</head>
<body>
<a class="skip" href="#main">{{ site.ui.skip_to_content }}</a>

<header>
  <div class="header-inner">
    <div class="site-title">
      <a href="index.html">
        <span class="mark">{{ site.title }}</span>
        <span class="mark-sub">{{ site.title_sub }}</span>
      </a>
    </div>
    <nav class="main" aria-label="{{ site.ui.main_nav }}">
      {% for slug, filename, navkey in pages %}
      <a href="{{ filename }}"{% if page == navkey %} class="active" aria-current="page"{% endif %}>{{ site.nav[navkey] }}</a>
      {% endfor %}
      <span class="lang">
        {% for l in langs %}
        <a href="{{ prefix }}{{ '' if l == 'en' else l + '/' }}{{ page_file }}"{% if l == lang %} class="current" aria-current="true"{% endif %} lang="{{ l }}">{{ lang_names[l] }}</a>
        {% endfor %}
      </span>
    </nav>
  </div>
</header>

{% block hero %}{% endblock %}

<main id="main">
{% block content %}{% endblock %}
</main>

<footer>
  <div class="foot-nav">
    {% for slug, filename, navkey in pages %}
    <a href="{{ filename }}">{{ site.nav[navkey] }}</a>
    {% endfor %}
  </div>
  <div>{{ site.footer.line }}</div>
  <div class="foot-legal">{{ site.footer.legal|safe }}</div>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
