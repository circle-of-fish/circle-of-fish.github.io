{% extends "base.html.j2" %}
{% block title %}{{ site.nav.publications }} — {{ site.title }}{% endblock %}
{% block description %}{{ publications.meta_description }}{% endblock %}

{% macro pub_item(pub) %}
<li class="pub"
    data-members="{{ pub.get('members', [])|map('memberkey')|join(' ') }}"
    data-lang="{{ pub.get('language', 'en') }}"
    data-oa="{{ 1 if pub.get('url_fulltext') else 0 }}">
  <div class="cite">
    <span class="authors">{{ pub.authors }}</span>.
    <span class="year">{{ pub.year }}</span>.
    <span class="title">{{ pub.title|safe }}</span>.
    <span class="venue">{{ pub.venue|safe }}</span>{% if pub.get('volume_issue_pages') %} {{ pub.get('volume_issue_pages') }}{% endif %}.
  </div>
  {% if pub.get('summary') %}<div class="summary">{{ pub.get('summary') }}</div>{% endif %}
  <div class="pub-links">
    {% if pub.get('url_fulltext') %}<a class="badge badge-oa" href="{{ pub.get('url_fulltext') }}" target="_blank" rel="noopener">{{ site.ui.full_text }}</a>{% endif %}
    {% if pub.get('doi') %}<a class="badge badge-doi" href="{{ pub.get('doi')|doi_url }}" target="_blank" rel="noopener">DOI</a>{% endif %}
    {% if pub.get('url_publisher') and not pub.get('doi') %}<a class="badge badge-doi" href="{{ pub.get('url_publisher') }}" target="_blank" rel="noopener">{{ site.ui.publisher }}</a>{% endif %}
    {% if pub.get('type_label') %}<span class="badge badge-type">{{ pub.get('type_label') }}</span>{% endif %}
    {% if pub.get('language') and pub.get('language') != 'en' %}<span class="badge badge-lang">{{ site.ui['lang_' + pub.get('language')] }}</span>{% endif %}
  </div>
</li>
{% endmacro %}

{% block hero %}
<div class="hero page">
  <h1>{{ publications.title }}</h1>
  <p class="subtitle">{{ publications.kicker }}</p>
  <p class="description">{{ publications.lede }}</p>
</div>
{% endblock %}

{% block content %}

<section>
  <div class="container">
    <form class="pub-filter" id="pub-filter" aria-label="{{ site.ui.filter_label }}" hidden>
      <label class="visually-hidden" for="f-member">{{ site.ui.filter_member }}</label>
      <select id="f-member">
        <option value="">{{ site.ui.filter_member }}</option>
        {% for m in publishing_members %}
        <option value="{{ m.key }}">{{ m.name }}</option>
        {% endfor %}
      </select>
      <label class="visually-hidden" for="f-lang">{{ site.ui.filter_lang }}</label>
      <select id="f-lang">
        <option value="">{{ site.ui.filter_lang }}</option>
        {% for code in ['en', 'ko', 'ja', 'zh'] %}
        <option value="{{ code }}">{{ site.ui['lang_' + code] }}</option>
        {% endfor %}
      </select>
      <label class="check"><input type="checkbox" id="f-oa"> {{ site.ui.filter_oa }}</label>
      <output id="f-count" class="filter-count" data-showing="{{ site.ui.filter_showing }}"></output>
    </form>
    <p class="filter-empty" id="f-empty" hidden>{{ site.ui.filter_none }}</p>

    <nav class="pub-nav" aria-label="{{ publications.themes_label }}">
      {% for th in publications.themes %}
      <a href="#{{ th.id }}">{{ th.title }}</a>
      {% endfor %}
    </nav>

    {% for th in publications.themes %}
    <div class="theme-block" id="{{ th.id }}">
      <div class="theme-head">
        <h3>{{ th.title }}</h3>
        <p class="blurb">{{ th.blurb }}</p>
        <span class="count" data-total="{{ th.entries|length }}" data-unit="{{ site.ui.count_unit }}">{{ th.entries|length }} {{ site.ui.count_unit }}</span>
      </div>
      <ul class="pub-list">
        {% for pub in th.entries %}
        {{ pub_item(pub) }}
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>

{% if publications.get('other_groups') %}
<section class="band">
  <div class="container">
    <h2 class="section-title">{{ publications.other_title }}</h2>
    <p class="section-subtitle">{{ publications.other_kicker }}</p>
    {% for g in publications.other_groups %}
    <div class="theme-block" id="{{ g.id }}">
      <div class="theme-head">
        <h3>{{ g.title }}</h3>
        {% if g.get('blurb') %}<p class="blurb">{{ g.blurb }}</p>{% endif %}
      </div>
      <ul class="pub-list">
        {% for pub in g.entries %}
        {{ pub_item(pub) }}
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<section{% if not publications.get('other_groups') %} class="band"{% endif %}>
  <div class="container narrow">
    <p class="note">{{ publications.oa_note|safe }}</p>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script src="{{ prefix }}filter.js" defer></script>
{% endblock %}
